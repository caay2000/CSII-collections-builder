<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <IsPackable>false</IsPackable>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
  <ItemGroup>
    <!-- La lógica pura se compila aquí directamente: no hay dependencias del juego. -->
    <Compile Include="../BuildingCollections/Core/*.cs" Link="Core/%(Filename)%(Extension)" />
    <Compile Include="../BuildingCollections.Simulator/*.cs" Exclude="../BuildingCollections.Simulator/Program.cs" Link="Simulator/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
